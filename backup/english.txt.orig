painteffect_materialproperties_mask_invert;Inverts the x value.
painteffect_materialproperties_normal_invert;Inverts the normal value.
painteffect_materialproperties_albedo_invert;Inverts the albedo value.
painteffect_materialproperties_specular_invert;Inverts the specular value..
painteffect_materialproperties_gloss_invert;Inverts the gloss value..
painteffect_materialproperties_roughness_invert;Inverts the roughness value.
painteffect_materialproperties_metalness_invert;Inverts the metalness value.
painteffect_materialproperties_occlusion_invert;Inverts the ambient occlusion value.
painteffect_materialproperties_cavity_invert;Inverts the cavity value.
painteffect_materialproperties_transparency_invert;Inverts the transparency value.
painteffect_materialproperties_displacement_invert;Inverts the displacement or heightmap value.
painteffect_materialproperties_albedometal_invert;Inverts the albedo (metalness) value.
painteffect_materialproperties_bump_invert;Inverts the bump value.
painteffect_materialproperties_emissive_invert;Inverts the emissive value.
painteffect_materialproperties_scatter_invert;Inverts the subsurface scattering value.
painteffect_materialproperties_sss_mask_invert;Inverts the subsurface scattering mask value.
painteffect_materialproperties_aniso_dir_invert;Inverts the aniisotropic direction value.
painteffect_materialproperties_fuzz_invert;Inverts the fuzz value.
painteffect_materialproperties_refraction_mask_invert;Inverts the refraction mask value.
